# ---------------------------------------------------------------------------
# Enterprise ERP — environment variable reference (.env.example)
#
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (the only place connection credentials are supplied) ---------
DATABASE_URL=postgresql+psycopg2://erp:erp@localhost:5432/erp

# --- Application secrets -----------------------------------------------------
# HMAC key signing JWTs + the key from which bot-token encryption keys are
# derived. Production refuses to boot with the insecure default.
SECRET_KEY=change-me-to-a-long-random-string

# --- Bot messenger tokens (dev fallback only) -------------------------------
# The preferred way to configure tokens is the ERP admin UI
# (Settings -> Bots / Messaging), which stores them encrypted at rest.
# These env vars are the development fallback used by bots/config.py when no
# backend-managed token exists. Leave empty unless you need the fallback.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Optional Telegram-only proxy. Set this to the existing Sing-box local
# HTTP(S) or SOCKS listener, for example http://127.0.0.1:<port> or
# socks5://127.0.0.1:<port>. Leave empty when the OS/TUN route resolves and
# reaches Telegram directly. This is read by bots/config.py and applied only
# to aiogram's Telegram session; it does not change Windows DNS or TLS.
TELEGRAM_PROXY=

# --- Bot process configuration ----------------------------------------------
# Base URL the Telegram/Bale bot processes use to reach the backend API.
BOT_API_BASE_URL=http://localhost:8000

# Shared secret authorizing the bot processes to fetch their own tokens from
# GET /api/v1/bot-config/{platform}/token. The backend and the bot processes
# must agree on this value. The backend default is dev-only; set it explicitly
# outside development.
BOT_RUNTIME_SECRET=dev-bot-runtime-secret
